# Rendered by entrypoint.sh into /etc/mitrity/gateway.yaml, mode 0600: the
# rendered file carries the agent key.
agent_id: "${MITRITY_AGENT_ID}"
api_key: "${MITRITY_AGENT_KEY}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

# Loopback admission API: the second entrance. The Claude Agent SDK's built-in
# tools (Bash, Write, Edit) never produce an MCP call; the mitrity adapter's
# PreToolUse hook asks this listener before the SDK runs them. Unix socket and
# token file live in /run/mitrity (mode 0700, owned by the demo user; created
# by the Dockerfile; entrypoint.sh checks the ownership and re-asserts the mode).
admission:
  enabled: true
  listen_addr: "unix:/run/mitrity/admission.sock"
  token_file: "/run/mitrity/admission.token"

# Each upstream's tools are served under its namespace as <namespace>__<tool>
# (fs__read_file, shell__run_command, api__call_api). Claude Code exposes MCP
# tools to the model as mcp__<server>__<tool>, and the Anthropic API accepts
# tool names matching ^[a-zA-Z0-9_-]{1,128}$ only, so the double underscore
# is the one separator that can be called from the Agent SDK. Policies target
# a tool as mcp:<namespace>__<tool> (see README).
upstreams:
  - name: "filesystem"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "fs", "--workspace", "/workspace"]
    namespace: "fs"

  - name: "shell"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "shell"]
    namespace: "shell"

  - name: "api"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "api"]
    namespace: "api"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100

# Phase 6 (credential broker demo) requires injection on. The
# ${credential:demo_db_password} placeholder in connect_database calls
# is substituted by the gateway before the upstream tool receives the
# call. Customers who don't provision the credential in their tenant
# see Phase 6 fail closed with credential.unresolvable — Phases 1-5
# run normally regardless.
credentials:
  injection_enabled: true
  cache_ttl_seconds: 30
