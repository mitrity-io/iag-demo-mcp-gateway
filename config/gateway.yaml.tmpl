gateway_id: "demo-gateway"
api_key: "${MITRITY_AGENT_KEY}"
agent_id: "${MITRITY_AGENT_ID}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

upstreams:
  - name: "filesystem"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "fs", "--workspace", "/workspace"]
    namespace: "fs"

  - name: "shell"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "shell"]
    namespace: "shell"

  - name: "api"
    command: "/usr/local/bin/demo-tools"
    args: ["--mode", "api"]
    namespace: "api"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100
