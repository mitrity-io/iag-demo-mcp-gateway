# Required — Claude Agent SDK
ANTHROPIC_API_KEY=sk-ant-...

# Required — MITRITY control plane connection
MITRITY_AGENT_ID=your-agent-uuid
MITRITY_AGENT_KEY=ak_...
MITRITY_CONTROL_PLANE_URL=https://api.mitrity.com

# Optional
MITRITY_DEMO_SPEED=normal
ANTHROPIC_MODEL=claude-sonnet-5
# Phase 9 needs a gateway with the governed shell (sentinel >= v0.21.0); set to 1 to run it anyway.
MITRITY_DEMO_FORCE_PHASE9=0
